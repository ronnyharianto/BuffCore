<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Packaging metadata -->
    <PackageId>BuffCore.Utilities</PackageId>
    <Version>0.2.0</Version>
    <Authors>BuffCore Contributors</Authors>
    <Product>BuffCore</Product>
    <Description>General-purpose utilities for .NET services: enum description/mapping helpers, date-range calculations, SHA256/RSA helpers, a configurable SMTP email helper, and injectable JSON/HTTP helpers (JsonHelper, HttpClientHelper) with DI registration.</Description>
    <PackageTags>buffcore;utilities;enum;dates;json;http;email;smtp;rsa;hash;helpers</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- For EnumDto returned by EnumHelper.RetrieveEnumList. -->
    <ProjectReference Include="..\BuffCore.Abstractions\BuffCore.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ILogger for JsonHelper/HttpClientHelper; Microsoft.Extensions.DependencyInjection for the registration extension. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
