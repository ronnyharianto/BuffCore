<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Packaging metadata -->
    <PackageId>BuffCore.Abstractions</PackageId>
    <Version>0.1.0</Version>
    <Authors>BuffCore Contributors</Authors>
    <Product>BuffCore</Product>
    <Description>Standard API response and request contracts for .NET services: response DTO envelopes (Base/Object/Struct/Paging), paging and search input bases, and a request-scoped current-user accessor.</Description>
    <PackageTags>buffcore;dto;paging;abstractions;contracts</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sole package dependency. Used by PagingDto.ApplyPagination (async queryable paging).
         Roadmap: move queryable pagination into BuffCore.Data to drop this reference. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
