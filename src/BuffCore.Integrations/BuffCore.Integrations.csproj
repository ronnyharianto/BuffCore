<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Packaging metadata -->
    <PackageId>BuffCore.Integrations</PackageId>
    <Version>0.1.0</Version>
    <Authors>BuffCore Contributors</Authors>
    <Product>BuffCore</Product>
    <Description>Injectable cloud-integration helpers for .NET services: Google Cloud Storage (upload/download/signed URLs) and Firebase Cloud Messaging (token, multicast, data-only), with DI registration and host-owned configuration.</Description>
    <PackageTags>buffcore;integrations;google-cloud-storage;gcs;firebase;fcm;push;storage</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- FileDto returned by GoogleCloudStorageHelper.DownloadFileAsync. -->
    <ProjectReference Include="..\BuffCore.Abstractions\BuffCore.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Google.Cloud.Storage.V1: StorageClient/UploadObjectOptions/UrlSigner.
         FirebaseAdmin: FirebaseApp/FirebaseMessaging/BatchResponse.
         Google.Apis.Auth: CredentialFactory/ServiceAccountCredential (also transitive via Storage.V1). -->
    <PackageReference Include="Google.Cloud.Storage.V1" Version="4.14.0" />
    <PackageReference Include="FirebaseAdmin" Version="3.5.0" />
    <!-- ILogger for both helpers; Microsoft.Extensions.DependencyInjection.Abstractions for the registration extension. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
